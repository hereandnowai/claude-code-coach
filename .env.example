# Copy to .env in the repo root: Docker Compose and `./mvnw spring-boot:run` (from backend/) both read it.
# An optional backend/.env overrides it for local runs only.
# Never commit the real .env files.

# Required. Google AI Studio API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Enables POST /api/admin/reindex (send "Authorization: Bearer <token>").
ADMIN_TOKEN=

# Optional. Gemma 4 thinking level: LOW (default), HIGH, or NONE to send no thinking config.
# COACH_THINKING_LEVEL=LOW

# Optional. Daily docs refresh (Spring cron: sec min hour day month weekday). Default 03:00.
# COACH_REINDEX_CRON=0 0 3 * * *

# Optional. Browser origin(s) allowed by CORS, comma separated.
# COACH_ALLOWED_ORIGINS=http://localhost:5173

# Optional (Docker only). Host port for the web app. Default 8081.
# COACH_PORT=8081
